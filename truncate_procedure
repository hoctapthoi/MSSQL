Create proc [dbo].[usp_truncate] @table nvarchar (200)
with execute as owner
as 
begin 
 -- set nocount on added to prevent extra result sets from 
--- interfering with SELECT statements
   Set Nocount on;
  exec ('Truncate table ' + @table)
END


